generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  ACCOUNTS
  SALES_MANAGER
  SALES_STAFF
  OPERATIONS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CUSTOMER_CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  FULLY_PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  ONLINE_TRANSFER
  CREDIT_CARD
  CHEQUE
}

enum DocumentType {
  PASSPORT
  VISA
  INSURANCE
  RECEIPT
  INVOICE
  OTHER
}

enum NotificationType {
  OVERDUE_PAYMENT
  DEPARTURE_REMINDER
  PASSPORT_EXPIRY
  SYSTEM
}

model User { id String @id @default(cuid()) name String email String @unique passwordHash String role Role @default(SALES_STAFF) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? bookings Booking[] notifications Notification[] followups FollowUp[] auditLogs AuditLog[] }
model TourPackage { id String @id @default(cuid()) code String @unique name String destination String durationDays Int adultPrice Decimal @db.Decimal(12,2) childPrice Decimal @db.Decimal(12,2) costPrice Decimal @db.Decimal(12,2) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? departures Departure[] bookings Booking[] }
model Departure { id String @id @default(cuid()) packageId String departureDate DateTime capacity Int createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? package TourPackage @relation(fields:[packageId], references:[id]) bookings Booking[] }
model Booking { id String @id @default(cuid()) reference String @unique userId String packageId String departureId String? customerName String customerEmail String customerPhone String totalAmount Decimal @db.Decimal(12,2) depositAmount Decimal @default(0) @db.Decimal(12,2) collectedAmount Decimal @default(0) @db.Decimal(12,2) outstandingAmount Decimal @default(0) @db.Decimal(12,2) bookingStatus BookingStatus @default(PENDING) paymentStatus PaymentStatus @default(UNPAID) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? user User @relation(fields:[userId], references:[id]) package TourPackage @relation(fields:[packageId], references:[id]) departure Departure? @relation(fields:[departureId], references:[id]) payments Payment[] documents Document[] reports Report[] followups FollowUp[] }
model Passenger { id String @id @default(cuid()) fullName String passportNo String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? }
model Payment { id String @id @default(cuid()) bookingId String amount Decimal @db.Decimal(12,2) method PaymentMethod status PaymentStatus paidAt DateTime @default(now()) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? booking Booking @relation(fields:[bookingId], references:[id]) }
model Document { id String @id @default(cuid()) bookingId String type DocumentType fileName String fileUrl String mimeType String fileSize Int createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? booking Booking @relation(fields:[bookingId], references:[id]) }
model Report { id String @id @default(cuid()) bookingId String? name String reportType String payload Json? generatedBy String createdAt DateTime @default(now()) booking Booking? @relation(fields:[bookingId], references:[id]) }
model Notification { id String @id @default(cuid()) userId String type NotificationType title String message String isRead Boolean @default(false) createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model FollowUp { id String @id @default(cuid()) bookingId String? userId String customerName String dueDate DateTime status String @default("PENDING") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? booking Booking? @relation(fields:[bookingId], references:[id]) user User @relation(fields:[userId], references:[id]) }
model AuditLog { id String @id @default(cuid()) userId String action String entity String entityId String payload Json? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
