generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN AGENT FINANCE }
enum BookingStatus { DRAFT CONFIRMED CANCELLED COMPLETED }

model User { id String @id @default(cuid()) name String email String @unique password String? role Role @default(AGENT) createdAt DateTime @default(now()) bookings Booking[] }
model Passenger { id String @id @default(cuid()) fullName String passportNo String? nationality String? bookings BookingPassenger[] }
model TourPackage { id String @id @default(cuid()) code String @unique name String price Decimal @db.Decimal(10,2) departures Departure[] bookings Booking[] }
model Departure { id String @id @default(cuid()) packageId String date DateTime seats Int package TourPackage @relation(fields:[packageId], references:[id]) }
model Booking { id String @id @default(cuid()) refNo String @unique userId String packageId String departureId String? status BookingStatus @default(DRAFT) totalAmount Decimal @db.Decimal(10,2) paidAmount Decimal @default(0) @db.Decimal(10,2) createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) package TourPackage @relation(fields:[packageId], references:[id]) departure Departure? @relation(fields:[departureId], references:[id]) passengers BookingPassenger[] payments Payment[] documents Document[] }
model BookingPassenger { bookingId String passengerId String booking Booking @relation(fields:[bookingId], references:[id]) passenger Passenger @relation(fields:[passengerId], references:[id]) @@id([bookingId, passengerId]) }
model Payment { id String @id @default(cuid()) bookingId String amount Decimal @db.Decimal(10,2) method String paidAt DateTime @default(now()) booking Booking @relation(fields:[bookingId], references:[id]) }
model Document { id String @id @default(cuid()) bookingId String fileName String filePath String uploadedAt DateTime @default(now()) booking Booking @relation(fields:[bookingId], references:[id]) }
